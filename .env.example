# Supabase connection — required
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
# VAPID_PRIVATE_KEY goes in Supabase edge function secrets only (never in frontend .env)

# ── Asistente Técnico RAG (scripts de ingesta locales) ──────────────────────
# Supabase service role key (solo para scripts locales de ingesta, NUNCA en frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Voyage AI API key — registro gratis en https://www.voyageai.com
# Plan gratuito: 50M tokens/mes — suficiente para toda la ingesta inicial
VOYAGE_API_KEY=pa-your-voyage-api-key-here

VITE_ADMIN_EMAIL=admin@yourdomain.com

# ── Checkout Invitado (Sprint Guest-1 DDL ejecutado; UI en Sprint Guest-2) ───
# Mantener en false hasta que Sprint Guest-2 esté completo y testeado en staging.
VITE_GUEST_CHECKOUT_ENABLED=false

# ── Activación del Marketplace (Bloque 1) ────────────────────────────────────
# false = marketplace oculto en UI y bloqueado en BD (piloto / Fase 1).
# Para activar: 1) SET value='true' en admin_automation_config.marketplace_phase_enabled
#               2) Redesplegar con VITE_MARKETPLACE_ENABLED=true
# Mantener en false hasta la activación coordinada con el equipo.
VITE_MARKETPLACE_ENABLED=false
